# Copy this file to deploy/backend.env on the Ubuntu host.
# Never commit deploy/backend.env; it contains deployment-specific identity data.
JOBHUNTER_ENV=production
JOBHUNTER_HOST=0.0.0.0
JOBHUNTER_PORT=8000
JOBHUNTER_WORKERS=1
JOBHUNTER_API_DOCS=false

# The browser frontend origin and public API hostname must be exact.
JOBHUNTER_ALLOWED_ORIGINS=https://career.example.com
JOBHUNTER_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1

# Required before the backend may listen beyond loopback.
JOBHUNTER_AUTH_MODE=cloudflare_access
JOBHUNTER_CF_ACCESS_TEAM_DOMAIN=team.cloudflareaccess.com
JOBHUNTER_CF_ACCESS_AUDIENCE=replace-with-cloudflare-access-audience
JOBHUNTER_ALLOWED_IDENTITY_EMAILS=owner@example.com

# Optional provider keys. Leave blank to keep deterministic local mode.
GLM_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
