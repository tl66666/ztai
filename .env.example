# 职途 AI 环境变量参考。
# 项目不会自动读取 .env 文件；请在启动进程前设置这些变量。

# 本地服务与数据。保持回环地址，除非你清楚单用户数据暴露风险。
JOBHUNTER_HOST=127.0.0.1
JOBHUNTER_PORT=5000
JOBHUNTER_WORKERS=1
JOBHUNTER_DB_PATH=jobhunter.db
JOBHUNTER_AGENT_USER_ID=1

# FastAPI/Cloudflare runtime. In production, use the exact frontend origins
# and the public API hostname. Keep one worker until PostgreSQL migration.
JOBHUNTER_ENV=development
JOBHUNTER_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
JOBHUNTER_ALLOWED_HOSTS=localhost,127.0.0.1
JOBHUNTER_API_DOCS=true

# 可选模型。留空时使用确定性本地规则模式。
JOBHUNTER_MODEL=
GLM_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
