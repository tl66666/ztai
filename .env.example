# 职途 AI 环境变量清单
# 本文件仅作为变量参考，应用不会自动加载 .env 文件。
# 请在启动进程前设置所需的环境变量。

# ========== 运行环境 ==========
# 开发环境（development / production）
JOBHUNTER_ENV=development

# 监听地址（本地模式固定为回环地址）
JOBHUNTER_HOST=127.0.0.1
JOBHUNTER_PORT=5000

# ========== 数据库 ==========
# SQLite 路径（默认在项目根目录）
JOBHUNTER_DB_PATH=jobhunter.db

# PostgreSQL 连接（生产环境）
# JOBHUNTER_DATABASE_URL=postgresql+psycopg://user:password@localhost/jobhunter

# ========== 文件存储 ==========
JOBHUNTER_UPLOAD_FOLDER=uploads
JOBHUNTER_EXPORT_FOLDER=exports
JOBHUNTER_BLOB_STORAGE_BACKEND=local

# Cloudflare R2（生产环境）
# JOBHUNTER_R2_ACCOUNT_ID=
# JOBHUNTER_R2_BUCKET=
# JOBHUNTER_R2_ACCESS_KEY_ID=
# JOBHUNTER_R2_SECRET_ACCESS_KEY=
# JOBHUNTER_R2_ENDPOINT_URL=

# ========== AI 模型 ==========
# 智谱 GLM
# GLM_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# Kimi / Moonshot
# KIMI_API_KEY=
# MOONSHOT_API_KEY=

# 自定义模型 ID（覆盖供应商默认模型）
# JOBHUNTER_MODEL=

# AI 配置文件路径（本机运行时保存 API Key）
JOBHUNTER_AI_CONFIG_PATH=output/runtime/ai-config.json

# ========== 认证 ==========
# 认证模式（local / cloudflare_access）
JOBHUNTER_AUTH_MODE=local
JOBHUNTER_AGENT_USER_ID=1

# Cloudflare Access（生产环境）
# JOBHUNTER_CF_ACCESS_TEAM_DOMAIN=
# JOBHUNTER_CF_ACCESS_AUDIENCE=
# JOBHUNTER_ALLOWED_IDENTITY_EMAILS=

# ========== 跨域 ==========
# 允许的前端来源（逗号分隔）
# JOBHUNTER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 允许的主机名（逗号分隔）
# JOBHUNTER_ALLOWED_HOSTS=localhost,127.0.0.1

# ========== 后台作业 ==========
JOBHUNTER_JOB_LEASE_SECONDS=60
JOBHUNTER_JOB_HEARTBEAT_SECONDS=20
JOBHUNTER_JOB_POLL_SECONDS=1
JOBHUNTER_JOB_MAX_ATTEMPTS=3

# ========== 其他 ==========
# API 文档开关（开发环境开启）
JOBHUNTER_API_DOCS=true
# 最大上传大小（字节）
JOBHUNTER_MAX_UPLOAD_BYTES=20971520
