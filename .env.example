# 职途AI 本地环境变量示例
# 复制为 .env 或在 PowerShell 中手动设置后再启动 Flask。

FLASK_ENV=development
JOBHUNTER_DB_PATH=jobhunter.db

# The single-user action confirmation API binds to loopback by default.
# Set JOBHUNTER_HOST only when you intentionally accept network exposure risk.
JOBHUNTER_HOST=127.0.0.1
JOBHUNTER_PORT=5000

# 可选：多模型 API Key。未配置时系统会自动使用本地规则兜底。
GLM_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=

# 可选：如果官方模型 ID 调整，可在页面“模型配置”里选择自定义模型 ID。
